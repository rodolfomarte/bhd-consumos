rules_version = '2';

// No cross-service Firestore reads here on purpose: the local Emulator
// Suite does not support them (verified by hand), and relying on a feature
// we can't test before publishing isn't worth it. Approval status and
// family are mirrored onto the Auth custom claims by the server
// (netlify/functions/set-user-status.js) every time an admin changes a
// user's status, so these rules only ever read request.auth.token.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    // Custom claims are ABSENT (not just false) for anyone who has never
    // had them set — accessing them directly throws in this rules engine,
    // so guard with 'in' first.
    function isAdmin() {
      return isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }
    // Manual admin approval is the ONLY gate — no email verification step.
    function isApproved() {
      return isSignedIn()
        && ('approved' in request.auth.token) && request.auth.token.approved == true;
    }
    function myFamilia() {
      return ('familia' in request.auth.token) ? request.auth.token.familia : null;
    }
    // Mirrored onto the Auth custom claims by netlify/functions/set-captain.js.
    function capitanVilla() {
      return ('capitanVilla' in request.auth.token) ? request.auth.token.capitanVilla : null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }
    // Retos evidence is a single required photo (no video) — same cap as
    // other photo uploads in the app.
    function isEvidenceFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
    }

    // mural/<familia>/<anio>  (one slot per family per year)
    match /mural/{familia}/{anio} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin()
        || (isApproved() && familia == myFamilia() && isImage());
      // Borrado real del archivo: admin, o cualquier aprobado de esa misma
      // familia (no solo quien lo subió) — antes solo el admin podía borrar
      // el archivo aunque el documento de Firestore sí se pudiera borrar.
      allow delete: if isAdmin() || (isApproved() && familia == myFamilia());
    }

    // live/<photoId>  (legacy, sin familia en la ruta — fotos subidas antes
    // del 2026-10-13). Se deja solo para que el admin pueda seguir
    // gestionando esos archivos viejos; las fotos nuevas usan la ruta con
    // familia de abajo, que sí permite borrado por familia.
    match /live/{photoId} {
      allow read: if isAdmin() || isApproved();
      allow delete: if isAdmin();
    }

    // live/<familia>/<photoId>  (esquema actual — misma familia que
    // mural/<familia>/<anio>, así que cualquier aprobado de esa familia
    // puede borrar su propia foto, no solo quien la subió).
    match /live/{familia}/{photoId} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin() || (isApproved() && familia == myFamilia() && isImage());
      allow delete: if isAdmin() || (isApproved() && familia == myFamilia());
    }

    // retos/<villa>/<retoId>/<fileName>  (evidence the villa's captain submits)
    match /retos/{villa}/{retoId}/{fileName} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin()
        || (isApproved() && capitanVilla() == villa && isEvidenceFile());
      allow delete: if isAdmin() || (isApproved() && capitanVilla() == villa);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
