rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────────── Helpers ───────────── */
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // request.auth.token.admin is ABSENT (not just false) for anyone who
      // isn't the admin — guard with 'in' before accessing it.
      return isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }
    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Manual admin approval is the ONLY gate — no email verification step.
    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUserDoc().data.status == 'approved';
    }
    function myFamilia() {
      return myUserDoc().data.familia;
    }
    function galleryEnabled() {
      return exists(/databases/$(database)/documents/config/settings)
        && get(/databases/$(database)/documents/config/settings).data.galleryEnabledForUsers == true;
    }
    // Mirrored onto the Auth custom claims by netlify/functions/set-captain.js
    // (same pattern as approved/familia) — never trust a client-asserted
    // villa, only the signed token.
    function isCaptainOfVilla(villa) {
      return isApproved() && ('capitanVilla' in request.auth.token) && request.auth.token.capitanVilla == villa;
    }
    // Mirrored onto the Auth custom claims by netlify/functions/set-music-manager.js
    // (same pattern as capitanVilla) — a single module-wide role, not per-villa.
    function isMusicManager() {
      return isApproved() && ('encargadoMusica' in request.auth.token) && request.auth.token.encargadoMusica == true;
    }
    function propuestasPausadas() {
      return exists(/databases/$(database)/documents/config/musica)
        && get(/databases/$(database)/documents/config/musica).data.propuestasPausadas == true;
    }
    function votacionPausada() {
      return exists(/databases/$(database)/documents/config/musica)
        && get(/databases/$(database)/documents/config/musica).data.votacionPausada == true;
    }

    /* ───────────── users/{uid} ─────────────
       Self-registration only creates a "pending" profile. Nobody can set
       their own status or an admin flag from the client — approvals and
       role changes happen server-side (Netlify function + Admin SDK),
       which bypasses these rules entirely. */
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre','familia','familiaLabel','username','email','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string && request.resource.data.username.size() >= 3
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.familia is string && request.resource.data.familia.size() > 0;

      // Owner may only ever touch their display name; status/familia/email/role
      // changes must go through the admin server functions.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','updatedAt'])
            && request.resource.data.status == resource.data.status
            && request.resource.data.familia == resource.data.familia
            && request.resource.data.email == resource.data.email);

      allow delete: if isAdmin();
    }

    /* ───────────── config/settings ─────────────
       Admin-only gallery toggle (and any future global switches). */
    match /config/{docId} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    /* "Próximo evento" — mensaje + cronómetro en Inicio, visible para
       CUALQUIERA (mismo nivel de apertura que el hero y la cuenta
       regresiva principal, que tampoco piden cuenta). */
    match /config/proximoEvento {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ───────────── publicContent/{docId} ─────────────
       Villas/agenda/menu — public marketing info, same as the rest of the
       landing page (itinerary, map, history). Readable by anyone, no login
       required; only the admin can edit it. Separate from config/ on
       purpose: that collection requires approval to read, this one must not. */
    match /publicContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ───────────── muralPhotos/{photoId} ─────────────
       One photo per family per year. Doc id must be "<familia>_<anio>" so a
       family can't spoof another family's slot. */
    match /muralPhotos/{photoId} {
      allow read: if isAdmin()
        || (isApproved() && (resource.data.familia == myFamilia() || galleryEnabled()));

      allow create: if (isAdmin() || (isApproved() && request.resource.data.familia == myFamilia()))
        && request.resource.data.uploaderUid == request.auth.uid
        && photoId == request.resource.data.familia + '_' + request.resource.data.anio
        && request.resource.data.keys().hasOnly(
             ['familia','familiaLabel','anio','url','description','uploaderUid','uploaderEmail','createdAt','likes','comments'])
        && request.resource.data.likes == []
        && request.resource.data.comments == [];

      // Likes/comments can be added by any approved member who can read the
      // photo; nobody may touch the immutable fields afterward. Separately,
      // anyone approved from the SAME family can replace the photo itself
      // (url/description/uploader info) — same "slot" (familia+año), keeps
      // whatever likes/comments it already had, never touches those in the
      // same write, and can never change familia/anio (that would be a
      // different slot, not a replacement of this one).
      allow update: if isAdmin()
        || (isApproved()
            && (resource.data.familia == myFamilia() || galleryEnabled())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments']))
        || (isApproved() && resource.data.familia == myFamilia()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['url','description','uploaderUid','uploaderEmail','createdAt'])
            && request.resource.data.familia == resource.data.familia
            && request.resource.data.anio == resource.data.anio);

      // Cualquier aprobado de esa misma familia puede borrar la foto (no
      // solo quien la subió) — el admin siempre puede, de cualquier familia.
      allow delete: if isAdmin() || (isApproved() && resource.data.familia == myFamilia());
    }

    /* ───────────── livePhotos/{photoId} ───────────── */
    match /livePhotos/{photoId} {
      allow read: if isAdmin()
        || (isApproved() && (resource.data.familia == myFamilia() || galleryEnabled()));

      allow create: if isApproved()
        && request.resource.data.familia == myFamilia()
        && request.resource.data.uploaderUid == request.auth.uid;

      allow update: if isAdmin()
        || (isApproved()
            && (resource.data.familia == myFamilia() || galleryEnabled())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments']));

      // Cualquier aprobado de esa misma familia puede borrar la foto (no
      // solo quien la subió) — el admin siempre puede, de cualquier familia.
      allow delete: if isAdmin() || (isApproved() && resource.data.familia == myFamilia());
    }

    /* ───────────── liveActivities/{id} ─────────────
       Admin-managed list of "moments" photos get tagged with. */
    match /liveActivities/{id} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    /* ───────────── retos/{villaSlug} ─────────────
       "Retos por Villas". A challenge stays genuinely invisible to
       non-admins while status == 'bloqueado' — enforced here, not just
       hidden with CSS on the client. Only the admin publishes/edits them. */
    match /retos/{villaSlug} {
      allow read: if isAdmin()
        || (isApproved() && resource.data.estado is string && resource.data.estado != 'bloqueado');
      allow write: if isAdmin();
    }

    /* ───────────── retoCaptains/{villaSlug} ─────────────
       Who captains each villa. Admin-only in every direction — the client
       never resolves "am I captain" from this doc, it reads the
       capitanVilla custom claim instead (set server-side alongside this
       doc by set-captain.js), so this collection is just the admin panel's
       view of the current assignment, not a permission source itself. */
    match /retoCaptains/{villaSlug} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    /* ───────────── retoEvidencias/{villa_retoId} ─────────────
       One evidence doc per villa per challenge (doc id "<villa>_<retoId>",
       enforced below so a captain can't spoof another villa's slot).
       Estados: 'pendiente' | 'correccion' | 'aprobado' (sin doc = sin
       entregar). The captain may only create/replace while there's no doc
       yet or while the admin asked for a correction — never while
       'pendiente' or 'aprobado'. Approving/requesting-correction/revoking
       is NOT done through these rules at all: netlify/functions/
       review-evidencia.js (Admin SDK, a transaction) is the only path that
       changes "estado" from the admin side, assigns points once, and
       swaps/restores the villa's approved photo — so a client can never
       self-approve or double-award points by racing a direct write. */
    match /retoEvidencias/{evidenciaId} {
      allow read: if isAdmin() || isApproved();

      allow create: if isAdmin()
        || (isCaptainOfVilla(request.resource.data.villa)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.estado == 'pendiente'
            && request.resource.data.fotoUrl is string && request.resource.data.fotoUrl.size() > 0
            && request.resource.data.nombreEquipo is string && request.resource.data.nombreEquipo.size() > 0
            && request.resource.data.eslogan is string && request.resource.data.eslogan.size() > 0
            && request.resource.data.puntosOtorgados == 0
            && evidenciaId == request.resource.data.villa + '_' + request.resource.data.retoId);

      // Resubmission always lands back in "pendiente" — never self-approve
      // — and can never touch villa/retoId/uid/puntosOtorgados/comentario
      // del admin/imagen anterior (esos solo los toca la función del admin).
      allow update: if isAdmin()
        || (isCaptainOfVilla(resource.data.villa)
            && resource.data.estado == 'correccion'
            && request.resource.data.villa == resource.data.villa
            && request.resource.data.retoId == resource.data.retoId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.estado == 'pendiente'
            && request.resource.data.fotoUrl is string && request.resource.data.fotoUrl.size() > 0
            && request.resource.data.nombreEquipo is string && request.resource.data.nombreEquipo.size() > 0
            && request.resource.data.eslogan is string && request.resource.data.eslogan.size() > 0
            && request.resource.data.puntosOtorgados == resource.data.puntosOtorgados
            && request.resource.data.comentarioAdmin == resource.data.comentarioAdmin
            && request.resource.data.imagenAnteriorUrl == resource.data.imagenAnteriorUrl
            && request.resource.data.imagenAnteriorPath == resource.data.imagenAnteriorPath);

      allow delete: if isAdmin();
    }

    /* ───────────── villaImagenes/{villaSlug} ─────────────
       The villa's current representative photo (set only by
       review-evidencia.js when an entry is approved/revoked). Same
       visibility as the rest of the retos content: admin + approved. */
    match /villaImagenes/{villaSlug} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    /* ───────────── villaPuntos/{villaSlug} ─────────────
       Running point total per villa, incremented/decremented only by
       review-evidencia.js inside a transaction (so an approve/revoke race
       or a double click can never double-count). */
    match /villaPuntos/{villaSlug} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    /* ───────────── villaPuntosAjustes/{autoId} ─────────────
       Bonus/penalizaciones sueltas (no ligadas a un reto específico), del
       reglamento físico — ej. "Espíritu de equipo +50", "Interferir con
       otro equipo -20". Admin-only; el cliente ajusta villaPuntos.total en
       la misma transacción al crear uno. */
    match /villaPuntosAjustes/{autoId} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    /* ─────────────── familiaRegistros/{familiaSlug} ─────────────────────
       Conteo de cuentas registradas por familia + última vez que alguien
       de esa familia entró — se muestra junto a cada familia en la sección
       pública "Nuestras Villas" (visible a cualquiera con cuenta, igual
       que esa sección, no hace falta estar aprobado). Cada quien solo
       puede tocar el doc de SU PROPIA familia, y solo de dos formas:
       sumar exactamente 1 a "registrados" (una vez, al crear su cuenta) o
       actualizar "ultimaActividad" a ahora (cada vez que inicia sesión) —
       nunca puede tocar el conteo de otra familia ni inventarse un salto
       mayor a 1. */
    match /familiaRegistros/{familiaSlug} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && myFamilia() == familiaSlug
        && request.resource.data.keys().hasOnly(['registrados', 'ultimaActividad'])
        && request.resource.data.registrados == 1;

      allow update: if isSignedIn() && myFamilia() == familiaSlug
        && request.resource.data.keys().hasOnly(['registrados', 'ultimaActividad'])
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaActividad'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrados', 'ultimaActividad'])
              && request.resource.data.registrados == resource.data.registrados + 1)
        );
    }

    /* ═══════════════════ "Pide tu canción" ═══════════════════════════════
       cancionesPedidas: una propuesta por doc. Se publican de inmediato
       (sin aprobación previa, decisión explícita del admin) — la única
       moderación es que admin/encargado puedan borrarla o editarla después.
       Los votos viven aparte (cancionVotos) para que los conteos salgan de
       documentos reales, nunca de un contador que el cliente pueda falsear,
       y para que el propio ID del documento ("<cancionId>_<uid>") le impida
       a Firestore crear un segundo voto de la misma persona aunque dos
       pestañas intenten votar al mismo tiempo (un "create" solo tiene éxito
       si el documento no existía). */
    match /cancionesPedidas/{cancionId} {
      allow read: if isAdmin() || isApproved();

      allow create: if request.resource.data.keys().hasOnly(
            ['titulo','artista','generoSlug','spotifyUrl','dedicatoria','familia','nombre','uid','estado','ocultaInapropiado','etiquetaContenido','ordenCola','creadoEn'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 150
        && request.resource.data.artista is string && request.resource.data.artista.size() > 0 && request.resource.data.artista.size() <= 120
        && request.resource.data.generoSlug in ['merengue','bachata','salsa','tipico','dembow','regueton','otro']
        && request.resource.data.spotifyUrl is string && request.resource.data.spotifyUrl.size() <= 300
        && request.resource.data.dedicatoria is string && request.resource.data.dedicatoria.size() <= 150
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ocultaInapropiado == false
        && request.resource.data.etiquetaContenido in ['', 'requiere-revision', 'version-limpia-verificada']
        && request.resource.data.ordenCola == 0
        && (
          // Propuesta de un invitado aprobado — atribuida a su propia familia real.
          // (el encargado/admin SIEMPRE puede agregar directo, aunque las
          // propuestas públicas estén pausadas — por eso esta pausa solo
          // aplica a esta rama, nunca a la de "Organización" de abajo.)
          (isApproved() && !propuestasPausadas()
            && request.resource.data.familia == myFamilia()
            && request.resource.data.nombre == myUserDoc().data.nombre
            && request.resource.data.estado == 'activa')
          ||
          // Agregada directo a la cola por el admin/encargado — se identifica
          // como "Organización", nunca suplanta a una familia real.
          ((isAdmin() || isMusicManager())
            && request.resource.data.familia == 'organizacion'
            && request.resource.data.nombre == 'Organización'
            && request.resource.data.estado in ['activa', 'en-cola'])
        );

      // Solo admin/encargado moderan — nunca cambian a quién pertenece la
      // propuesta (familia/uid/nombre quedan fijos para siempre).
      allow update: if (isAdmin() || isMusicManager())
        && request.resource.data.familia == resource.data.familia
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.nombre == resource.data.nombre;

      allow delete: if isAdmin() || isMusicManager();
    }

    match /cancionVotos/{voteId} {
      allow read: if isAdmin() || isApproved();

      // El voto normal solo lo crea la propia persona, para sí misma. El
      // admin/encargado tiene un segundo camino SOLO para fusionar
      // duplicados (mover el voto de alguien de la canción que desaparece
      // a la que se conserva) — nunca puede inventar un voto de la nada
      // con un uid cualquiera porque esa escritura solo ocurre al mover un
      // voto que ya existía (ver initMusicaFusion en musica-admin.js).
      allow create: if request.resource.data.keys().hasOnly(['cancionId','uid','familia','creadoEn'])
        && request.resource.data.cancionId is string
        && voteId == request.resource.data.cancionId + '_' + request.resource.data.uid
        && exists(/databases/$(database)/documents/cancionesPedidas/$(request.resource.data.cancionId))
        && get(/databases/$(database)/documents/cancionesPedidas/$(request.resource.data.cancionId)).data.estado != 'reproducida'
        && (
          (isApproved() && !votacionPausada()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.familia == myFamilia())
          || isAdmin() || isMusicManager()
        );

      allow delete: if isAdmin() || isMusicManager()
        || (isApproved() && resource.data.uid == request.auth.uid);
    }

    /* Bitácora de moderación — de solo lectura/escritura para quien modera,
       nunca editable ni borrable (historial honesto). */
    match /cancionModeracionLog/{autoId} {
      allow read: if isAdmin() || isMusicManager();
      allow create: if (isAdmin() || isMusicManager())
        && request.resource.data.keys().hasOnly(['accion','cancionId','titulo','detalle','uid','creadoEn'])
        && request.resource.data.uid == request.auth.uid;
    }

    /* Pausar propuestas/votación — el admin siempre, y también el
       encargado (es operación del día a día, no "configurar el módulo"). */
    match /config/musica {
      allow write: if isAdmin() || isMusicManager();
    }

    /* Singleton "qué canción está Sonando ahora mismo". Se escribe SIEMPRE
       dentro de una transacción de Firestore (ver marcarSonandoAtomico en
       musica-admin.js) junto con el update de estado de la canción vieja y
       la nueva — Firestore garantiza que esa transacción es serializable,
       así que dos administradores marcando "Sonando" al mismo tiempo nunca
       dejan dos canciones en ese estado: la segunda transacción se reintenta
       automáticamente sobre el resultado ya commiteado de la primera. */
    match /config/cancionSonando {
      allow read: if isAdmin() || isApproved();
      allow write: if (isAdmin() || isMusicManager())
        && request.resource.data.keys().hasOnly(['cancionId', 'actualizadoEn', 'actualizadoPor'])
        && request.resource.data.actualizadoPor == request.auth.uid;
    }
  }
}
