rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────────── Helpers ───────────── */
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // request.auth.token.admin is ABSENT (not just false) for anyone who
      // isn't the admin — guard with 'in' before accessing it.
      return isSignedIn() && ('admin' in request.auth.token) && request.auth.token.admin == true;
    }
    function emailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasApprovedProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUserDoc().data.status == 'approved';
    }
    // Verified email + approved standing: the bar for touching family data.
    function isApprovedVerified() {
      return emailVerified() && hasApprovedProfile();
    }
    function myFamilia() {
      return myUserDoc().data.familia;
    }
    function galleryEnabled() {
      return exists(/databases/$(database)/documents/config/settings)
        && get(/databases/$(database)/documents/config/settings).data.galleryEnabledForUsers == true;
    }

    /* ───────────── users/{uid} ─────────────
       Self-registration only creates a "pending" profile. Nobody can set
       their own status or an admin flag from the client — approvals and
       role changes happen server-side (Netlify function + Admin SDK),
       which bypasses these rules entirely. */
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre','familia','familiaLabel','email','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 80
        && request.resource.data.familia is string && request.resource.data.familia.size() > 0;

      // Owner may only ever touch their display name; status/familia/email/role
      // changes must go through the admin server functions.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','updatedAt'])
            && request.resource.data.status == resource.data.status
            && request.resource.data.familia == resource.data.familia
            && request.resource.data.email == resource.data.email);

      allow delete: if isAdmin();
    }

    /* ───────────── config/settings ─────────────
       Admin-only gallery toggle (and any future global switches). */
    match /config/{docId} {
      allow read: if isAdmin() || isApprovedVerified();
      allow write: if isAdmin();
    }

    /* ───────────── muralPhotos/{photoId} ─────────────
       One photo per family per year. Doc id must be "<familia>_<anio>" so a
       family can't spoof another family's slot. */
    match /muralPhotos/{photoId} {
      allow read: if isAdmin()
        || (isApprovedVerified() && (resource.data.familia == myFamilia() || galleryEnabled()));

      allow create: if (isAdmin() || (isApprovedVerified() && request.resource.data.familia == myFamilia()))
        && request.resource.data.uploaderUid == request.auth.uid
        && photoId == request.resource.data.familia + '_' + request.resource.data.anio
        && request.resource.data.keys().hasOnly(
             ['familia','familiaLabel','anio','url','description','uploaderUid','uploaderEmail','createdAt','likes','comments'])
        && request.resource.data.likes == []
        && request.resource.data.comments == [];

      // Likes/comments can be added by any approved+verified member who can
      // read the photo; nobody may touch the immutable fields afterward.
      allow update: if isAdmin()
        || (isApprovedVerified()
            && (resource.data.familia == myFamilia() || galleryEnabled())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments']));

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uploaderUid);
    }

    /* ───────────── livePhotos/{photoId} ───────────── */
    match /livePhotos/{photoId} {
      allow read: if isAdmin()
        || (isApprovedVerified() && (resource.data.familia == myFamilia() || galleryEnabled()));

      allow create: if isApprovedVerified()
        && request.resource.data.familia == myFamilia()
        && request.resource.data.uploaderUid == request.auth.uid;

      allow update: if isAdmin()
        || (isApprovedVerified()
            && (resource.data.familia == myFamilia() || galleryEnabled())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','comments']));

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.uploaderUid);
    }

    /* ───────────── liveActivities/{id} ─────────────
       Admin-managed list of "moments" photos get tagged with. */
    match /liveActivities/{id} {
      allow read: if isAdmin() || isApprovedVerified();
      allow write: if isAdmin();
    }
  }
}
